# backend/.env.example — backend/.env dosyasını bundan kopyalayıp doldurun.
# backend/.env asla commit edilmez (bkz. .gitignore).

# RAG servisinin (RunPod pod'u) o anki proxy adresi. Pod her yeniden başladığında
# değişir; güncel adresi RunPod panelinden alıp buraya yazın.
RAG_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/

# RAG servisi bir API key bekliyorsa buraya yazın; beklemiyorsa boş bırakın.
RAG_API_KEY=

# API Gateway'in dinleyeceği port (varsayılan 7500; sunucuda başka bir servis bu
# portu kullanıyorsa değiştirin — frontend'in environment.ts'i de aynı portu
# kullanır, GATEWAY_PORT tek başına değiştirmek yeterlidir).
GATEWAY_PORT=7500
