{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AiGatewayDatabase": "Host=localhost;Port=6432;Database=cwa_pm_ai;Username=cwa;Password=cwa-dev-password"
  },
  "Auth": {
    "Mode": "Dev",
    "Authority": "",
    "Audience": "cwa-project-management",
    "DevSigningKey": "dev-only-signing-key-change-me-32-bytes-min",
    "EnableDevTokenIssuer": true
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 6672,
    "VirtualHost": "/",
    "Username": "cwa",
    "Password": "cwa-dev-password"
  },
  "Services": {
    "ProjectService": "http://localhost:6001",
    "TaskService": "http://localhost:6002"
  },
  "AiDocumentExcerpts": {
    "MaxCharsPerDocument": 6000
  },
  "AiWorkPackageContextRetrieval": {
    "MaxCharsPerRetrievedContext": 4000
  },
  "Rag": {
    "BaseUrl": "http://localhost:8100",
    "ApiKey": "",
    "DefaultMode": "strict",
    "DefaultUseHistory": false,
    "JobPollIntervalMs": 1500,
    "JobPollTimeoutMs": 120000
  },
  "Ai": {
    "Provider": "Mock"
  },
  "Serilog": {
    "ElasticsearchUrl": ""
  }
}
